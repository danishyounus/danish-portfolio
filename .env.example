# Copy to .env.local for local use. Never commit real values.

# Public canonical URL used by metadata, Open Graph, sitemap and robots.
# Example: https://danish-portfolio.vercel.app
NEXT_PUBLIC_SITE_URL=

# Contact form delivery (all three are required).
# Without them the form returns 503 { configured: false } and the UI says nothing was sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
